#!/usr/bin/env bash
# yayh: the yay kit's helper CLI. Skills call it, so Claude never re-derives
# IDs, slugs, versions or config by hand. It's on PATH while the plugin is enabled.
set -euo pipefail

YAY_KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
YAY_LIB_DIR="$YAY_KIT_ROOT/lib"
# shellcheck source=../lib/common.sh
. "$YAY_LIB_DIR/common.sh"
. "$YAY_LIB_DIR/config.sh"
. "$YAY_LIB_DIR/frontmatter.sh"
. "$YAY_LIB_DIR/manifest.sh"
. "$YAY_LIB_DIR/git.sh"
. "$YAY_LIB_DIR/harness.sh"
. "$YAY_LIB_DIR/knowledge.sh"
. "$YAY_LIB_DIR/artifact.sh"
. "$YAY_LIB_DIR/release.sh"
. "$YAY_LIB_DIR/roadmap.sh"
. "$YAY_LIB_DIR/code.sh"
. "$YAY_LIB_DIR/review.sh"
. "$YAY_LIB_DIR/e2e.sh"

usage() {
  cat <<'EOF'
yayh <command> [args]

Kit
  version                          kit version (with a subcommand: the plugin's version, see below)
  root                             kit root (for templates and reference docs)

Config (.yay/config.json)
  config get <key> [fallback]      dotted key; arrays print one per line
  config fill <template> k=v...    substitute {version} {edition} {slug} {zip}
  config path                      path of the repo config
  config validate                  check required keys, files and formats

IDs, slugs, front-matter
  slug <text>                      kebab-case slug, max 50 chars
  id next <R|BS|P|B|BL>            next free id in docs/
  id find <ID>                     file(s) that declare the id
  fm get <file> <key>
  fm set <file> <key> <value>

Manifest (.yay/manifest.json)
  manifest status [entry...]       clean|modified|missing per kit-owned file
  manifest record <entry> [tpl]    store the current hash (entry may end #managed)
  manifest forget <entry>
  manifest hash <entry>

Harness
  harness status                   not-initialized | no-manifest | current X | outdated X -> Y
  harness detect                   print a proposed .yay/config.json for this repo
  harness inventory [--keep=<path>]...
                                   old-harness files: wipe/keep/untracked (TSV)
  harness wipe --yes [--keep=<path>]... [--allow-base]
                                   git rm the old harness (needs a clean tree, not on base)
  harness sync [--check] [--force] [--diff] [--only=claude-md,rules,settings,github,docs]
                                   write kit-owned files; prints <action>\t<entry>
  harness files                    kit-written paths that exist (stage these, never git add -A)
  harness render <template>        render one template with this repo's config

Artifacts (brainstorms, plans, bugs, backlog)
  artifact new <brainstorm|plan|bug|backlog> "<title>" [from=X] [roadmap=R-n] [type=feat] [severity=high] [editions="free, pro"]
                                   create from the template with the next id; prints the path
  artifact resolve <ID|path|slug>  path of one artifact
  artifact list [type] [--status=s] id, status, title, path (TSV)
  artifact carry <worktree> <path>...
                                   move new (untracked) artifacts from this checkout into a worktree
  plan tasks <plan>                T<n>, done|open, text (TSV)
  plan tick <plan> <T<n>> [--undo] tick a task's checkbox
  plan check <plan>                structure errors and warnings (exit 1 on errors)
  id conflicts [base]              ids this branch adds that the base branch already uses

Roadmap (docs/roadmap.md)
  roadmap list [--status=s] [--sprint=n|later]
                                   id, status, size, section, title (TSV)
  roadmap get <R-n> <key>          one bullet's value
  roadmap set <R-n> <key> <value>  replace or add a bullet (status is validated)
  roadmap add "<title>" [sprint=n|later] [size=S|M|L] [why=…] [key=value…]
                                   append an item with the next R id; prints it
  roadmap move <R-n> <n|later>     move an item to another sprint or section
  roadmap sprints start=YYYY-MM-DD length=2w until=YYYY-MM-DD|count=N [first=n] [--md]
                                   sprint calendar (TSV, or ## headings)
  roadmap current [YYYY-MM-DD]     the sprint containing the date
  roadmap check [--today=]         structure, statuses, overlaps, slipped items
  roadmap status [--today=]        sprint counts, slipped items, open bugs, active plans
  roadmap links                    items that brainstorms/plans point at: id, current, suggested status, via
  roadmap peers                    sibling plugin folders (dir, name, slug, harnessed, path)

Code (reuse before you write)
  code find <words...> [--limit=N] [--kind=function|method|class|const]
                                   existing symbols whose names match, best first: score, file:line, kind, name, signature
  code similar <identifier>        code find for the words of one name (formatFeeLabel -> format fee label)
  code index [file...]             every class/function/method/const: file, line, kind, name, signature
  code new [base]                  symbols defined in lines this branch adds
  review diff [base] [--plan=P-n]  flag-only findings on this branch's changes: look-alike new functions,
                                   edited/grown/heavy/cross-file/change-log comments, docblock prose,
                                   files outside the plan (kind, where, message; always exits 0)

E2E (Playwright + wp-env, one site per checkout; reference/e2e.md)
  e2e status                       setup, deps, docker, env (up|down|external) + URL, port, spec files (TSV)
  e2e detect                       an existing browser-test setup: playwright|wp-env|cypress|script|ci (TSV)
  e2e scaffold [dir=tests/e2e] [--no-ci]
                                   write missing starter files and config keys (never overwrites)
  e2e port | e2e url               this checkout's port / base URL (worktrees get their own)
  e2e env start|stop|reset         wp-env for this checkout (reset wipes the site and re-seeds it)
  e2e run [playwright args...]     commands.e2e against this checkout's site, e.g. --grep "@P-4|@smoke"
  e2e specs [ID]                   spec files with test counts, or the tests tagged @ID (file:line:text)
  e2e cli <command...>             run in the wp-env cli container: wp option get x, tail -n 50 wp-content/debug.log

Commands and debugging
  run <name> [version=x] [edition=y]
                                   run commands.<name> from .yay/config.json in the repo root
  debug markers                    yay:debug instrumentation left in the tree (path:line:text)

Versions, changelog, build
  version current                  version from the first versionFiles match
  version list                     every versionFiles match (file, version)
  version check                    exit 1 unless all versionFiles agree
  version set <x.y.z>              rewrite every versionFiles match
  version tested wp=X.Y [wc=X.Y]   readme "Tested up to", header "WC tested up to", config tested.*
  changelog collect [--since=<tag>] [--to=<ref>]
                                   commits as TSV: sha type scope breaking subject pr fixes roadmap plan
  changelog suggest [--since=<tag>] major|minor|patch|none from the commit types
  changelog baseline               last tag, else the commit that introduced the current version
  changelog style                  the readme's heading template, bullet marker and labels
  changelog write <version> <bullets-file> [--date=YYYY-MM-DD] [--replace]
                                   insert the entry under == Changelog ==
  changelog entry <version>        print that version's bullets
  build zip [edition=e] [version=v] newest zip matching package.output
  build check <zip> [edition=e] [version=v]
                                   PASS/WARN/FAIL per check; exit 1 on any FAIL

Knowledge (CLAUDE.md project block + docs/knowledge/)
  knowledge docs                   list knowledge docs
  knowledge check [file...]        paths/links exist, front-matter, length budget
  knowledge stale [--since=<ref|tag|YYYY-MM-DD>]
                                   stale|fresh|never|bad-ref|uncovered per doc (exit 1 if any stale)
  knowledge stamp <doc|CLAUDE.md> [ref]
                                   record the commit a doc was verified against (default HEAD)
  knowledge block                  print the CLAUDE.md project block

Git
  git base                         base branch
  git branch-name <type> <text>    validated <type>/<slug>
  git branch-check <branch>        exit 0 if the name follows conventions
  git commit-check <msg|file>      exit 0 if the header is a valid conventional commit
  git last-tag                     latest release tag (version order)
  git tag-for <version>            tag name for a version
  git version-of-tag <tag>
  git bump <current> <major|minor|patch|x.y.z>
  git worktree <branch> [from]     create or reuse .claude/worktrees/<slug>, print path
  git merged-worktrees [base]      worktrees whose branch is merged into base (path, branch)

Environment: YAY_REPO overrides the repo root, YAY_JSON_ENGINE forces jq|node|php|python3.
EOF
}

# `-h`/`--help` anywhere prints usage and changes nothing (so `artifact new bug --help`
# can never create an artifact titled "--help").
for _a in "$@"; do case "$_a" in -h|--help) usage; exit 0 ;; esac; done

cmd="${1:-help}"; shift || true
case "$cmd" in
  version)
    if [ $# -eq 0 ]; then yay_kit_version; exit 0; fi
    sub="$1"; shift
    case "$sub" in
      current) yay_version_current ;;
      list) yay_version_list ;;
      check) yay_version_check ;;
      set) [ $# -eq 1 ] || yay_die "usage: yayh version set <x.y.z>"; yay_version_set "$1" ;;
      tested) yay_tested_set "$@" ;;
      *) yay_die "usage: yayh version [current|list|check|set|tested]" ;;
    esac ;;
  root) printf '%s\n' "$YAY_KIT_ROOT" ;;
  slug) [ $# -gt 0 ] || yay_die "usage: yayh slug <text>"; yay_slugify "$*" ;;
  config)
    sub="${1:-}"; shift || true
    case "$sub" in
      get) [ $# -ge 1 ] || yay_die "usage: yayh config get <key> [fallback]"
           yay_config_get "$@" || yay_die "config key '$1' is not set in $(yay_config_file)" ;;
      fill) [ $# -ge 1 ] || yay_die "usage: yayh config fill <template> k=v..."; yay_fill "$@" ;;
      path) yay_config_file ;;
      validate) yay_config_validate && echo "config ok" ;;
      *) yay_die "usage: yayh config get|fill|path|validate" ;;
    esac ;;
  id)
    sub="${1:-}"; shift || true
    case "$sub" in
      next) [ $# -eq 1 ] || yay_die "usage: yayh id next <R|BS|P|B|BL>"; yay_id_next "$1" ;;
      conflicts) yay_id_conflicts "$@" ;;
      find) [ $# -eq 1 ] || yay_die "usage: yayh id find <ID>"; yay_id_find "$1" || yay_die "no artifact declares $1" ;;
      *) yay_die "usage: yayh id next|find|conflicts" ;;
    esac ;;
  fm)
    sub="${1:-}"; shift || true
    case "$sub" in
      get) [ $# -eq 2 ] || yay_die "usage: yayh fm get <file> <key>"; yay_fm_get "$1" "$2" || exit 3 ;;
      set) [ $# -eq 3 ] || yay_die "usage: yayh fm set <file> <key> <value>"; yay_fm_set "$1" "$2" "$3" ;;
      *) yay_die "usage: yayh fm get|set" ;;
    esac ;;
  manifest)
    sub="${1:-}"; shift || true
    case "$sub" in
      status) yay_manifest_status "$@" ;;
      record) [ $# -ge 1 ] || yay_die "usage: yayh manifest record <entry> [template]"; yay_manifest_record "$@" ;;
      forget) [ $# -eq 1 ] || yay_die "usage: yayh manifest forget <entry>"; yay_manifest_forget "$1" ;;
      hash) [ $# -eq 1 ] || yay_die "usage: yayh manifest hash <entry>"; yay_manifest_hash "$1" || yay_die "cannot hash $1" ;;
      *) yay_die "usage: yayh manifest status|record|forget|hash" ;;
    esac ;;
  git)
    sub="${1:-}"; shift || true
    case "$sub" in
      base) yay_base_branch ;;
      branch-name) [ $# -ge 2 ] || yay_die "usage: yayh git branch-name <type> <text>"; yay_branch_name "$@" ;;
      branch-check) [ $# -eq 1 ] || yay_die "usage: yayh git branch-check <branch>"
                    yay_branch_check "$1" || { echo "branch '$1' must be <type>/<kebab-slug> with type in: $(yay_config_get git.branchTypes | tr '\n' ' ')" >&2; exit 1; } ;;
      commit-check) [ $# -eq 1 ] || yay_die "usage: yayh git commit-check <msg|file>"; yay_commit_check "$1" ;;
      last-tag) yay_last_tag ;;
      tag-for) [ $# -eq 1 ] || yay_die "usage: yayh git tag-for <version>"; yay_tag_for "$1" ;;
      version-of-tag) [ $# -eq 1 ] || yay_die "usage: yayh git version-of-tag <tag>"; yay_version_of_tag "$1" ;;
      bump) [ $# -eq 2 ] || yay_die "usage: yayh git bump <current> <major|minor|patch|x.y.z>"; yay_semver_bump "$1" "$2" ;;
      worktree) [ $# -ge 1 ] || yay_die "usage: yayh git worktree <branch> [from]"; yay_worktree_create "$@" ;;
      merged-worktrees) yay_merged_worktrees "$@" ;;
      *) yay_die "usage: yayh git base|branch-name|branch-check|commit-check|last-tag|tag-for|version-of-tag|bump|worktree|merged-worktrees" ;;
    esac ;;
  harness)
    sub="${1:-}"; shift || true
    case "$sub" in
      status) yay_harness_status ;;
      detect) yay_detect ;;
      inventory) yay_inventory "$@" ;;
      wipe) yay_wipe "$@" ;;
      sync) yay_sync "$@" ;;
      files) yay_harness_files | sort -u ;;
      render) [ $# -eq 1 ] || yay_die "usage: yayh harness render <template>"; yay_render "$YAY_TEMPLATES/$1" ;;
      *) yay_die "usage: yayh harness status|detect|inventory|wipe|sync|render" ;;
    esac ;;
  artifact)
    sub="${1:-}"; shift || true
    case "$sub" in
      new) [ $# -ge 2 ] || yay_die "usage: yayh artifact new <type> \"<title>\" [key=value...]"; yay_artifact_new "$@" ;;
      resolve) [ $# -eq 1 ] || yay_die "usage: yayh artifact resolve <ID|path|slug>"; yay_artifact_resolve "$1" || yay_die "no artifact matches '$1'" ;;
      list) yay_artifact_list "$@" ;;
      carry) [ $# -ge 2 ] || yay_die "usage: yayh artifact carry <worktree> <path>..."; yay_artifact_carry "$@" ;;
      *) yay_die "usage: yayh artifact new|resolve|list|carry" ;;
    esac ;;
  plan)
    sub="${1:-}"; shift || true
    case "$sub" in
      tasks) [ $# -eq 1 ] || yay_die "usage: yayh plan tasks <plan>"; yay_plan_tasks "$1" ;;
      tick) [ $# -ge 2 ] || yay_die "usage: yayh plan tick <plan> <T<n>> [--undo]"; yay_plan_tick "$@" ;;
      check) [ $# -eq 1 ] || yay_die "usage: yayh plan check <plan>"; yay_plan_check "$1" ;;
      *) yay_die "usage: yayh plan tasks|tick|check" ;;
    esac ;;
  roadmap)
    sub="${1:-}"; shift || true
    case "$sub" in
      list) yay_roadmap_list "$@" ;;
      get) [ $# -eq 2 ] || yay_die "usage: yayh roadmap get <R-n> <key>"; yay_roadmap_get "$1" "$2" ;;
      set) [ $# -eq 3 ] || yay_die "usage: yayh roadmap set <R-n> <key> <value>"; yay_roadmap_set "$1" "$2" "$3" ;;
      add) [ $# -ge 1 ] || yay_die "usage: yayh roadmap add \"<title>\" [sprint=n|later] [key=value...]"; yay_roadmap_add "$@" ;;
      move) [ $# -eq 2 ] || yay_die "usage: yayh roadmap move <R-n> <n|later>"; yay_roadmap_move "$1" "$2" ;;
      sprints) yay_roadmap_sprints "$@" ;;
      current) yay_roadmap_current "$@" ;;
      check) yay_roadmap_check "$@" ;;
      status) yay_roadmap_status "$@" ;;
      peers) yay_roadmap_peers ;;
      links) yay_roadmap_links ;;
      *) yay_die "usage: yayh roadmap list|get|set|add|move|sprints|current|check|status|links|peers" ;;
    esac ;;
  code)
    sub="${1:-}"; shift || true
    case "$sub" in
      find) yay_code_find "$@" ;;
      similar) [ $# -ge 1 ] || yay_die "usage: yayh code similar <identifier>"; yay_code_similar "$@" ;;
      index) yay_code_index "$@" ;;
      new) yay_code_new "$@" ;;
      *) yay_die "usage: yayh code find|similar|index|new" ;;
    esac ;;
  review)
    case "${1:-}" in diff) shift; yay_review_diff "$@" ;; *) yay_die "usage: yayh review diff [base] [--plan=P-n]" ;; esac ;;
  e2e)
    sub="${1:-}"; shift || true
    case "$sub" in
      status) yay_e2e_status ;;
      detect) yay_e2e_detect ;;
      scaffold) yay_e2e_scaffold "$@" ;;
      port) yay_e2e_port ;;
      url) yay_e2e_url ;;
      env) yay_e2e_env "$@" ;;
      run) yay_e2e_run "$@" ;;
      specs) yay_e2e_specs "$@" ;;
      cli) yay_e2e_cli "$@" ;;
      *) yay_die "usage: yayh e2e status|detect|scaffold|port|url|env|run|specs|cli" ;;
    esac ;;
  run) [ $# -ge 1 ] || yay_die "usage: yayh run <command-name> [k=v...]"; yay_run "$@" ;;
  debug)
    case "${1:-}" in markers) yay_debug_markers ;; *) yay_die "usage: yayh debug markers" ;; esac ;;
  changelog)
    sub="${1:-}"; shift || true
    case "$sub" in
      collect) yay_changelog_collect "$@" ;;
      suggest) yay_changelog_suggest "$@" ;;
      baseline) yay_changelog_baseline ;;
      style) yay_changelog_style ;;
      write) [ $# -ge 2 ] || yay_die "usage: yayh changelog write <version> <bullets-file> [--date=] [--replace]"; yay_changelog_write "$@" ;;
      entry) [ $# -eq 1 ] || yay_die "usage: yayh changelog entry <version>"; yay_changelog_entry "$1" ;;
      *) yay_die "usage: yayh changelog collect|suggest|baseline|style|write|entry" ;;
    esac ;;
  build)
    sub="${1:-}"; shift || true
    case "$sub" in
      zip) yay_zip_path "$@" ;;
      check) [ $# -ge 1 ] || yay_die "usage: yayh build check <zip> [edition=e] [version=v]"; yay_zip_check "$@" ;;
      *) yay_die "usage: yayh build zip|check" ;;
    esac ;;
  knowledge)
    sub="${1:-}"; shift || true
    case "$sub" in
      docs) yay_knowledge_docs ;;
      check) yay_knowledge_check "$@" ;;
      stale) yay_knowledge_stale "$@" ;;
      stamp) [ $# -ge 1 ] || yay_die "usage: yayh knowledge stamp <doc|CLAUDE.md> [ref]"; yay_knowledge_stamp "$@" ;;
      block) yay_project_block ;;
      *) yay_die "usage: yayh knowledge docs|check|stale|stamp|block" ;;
    esac ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
