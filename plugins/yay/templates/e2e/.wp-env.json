{
  "core": null,
  "phpVersion": "8.2",
  "plugins": [{{e2e.plugins}}],
  "mappings": {
    "wp-content/plugins/{{e2e.folder}}": "{{e2e.root}}"
  },
  "port": {{e2e.port}},
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true
  },
  "lifecycleScripts": {
    "afterStart": "bash ./bin/setup-env.sh",
    "afterClean": "bash ./bin/setup-env.sh"
  }
}
