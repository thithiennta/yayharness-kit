{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yayharness/config.schema.json",
  "title": "yay harness repo config",
  "type": "object",
  "required": [
    "schemaVersion",
    "plugin",
    "editions",
    "git",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "plugin": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "mainFile"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "mainFile": {
          "type": "string"
        },
        "textDomain": {
          "type": "string"
        },
        "wporgSlug": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "php": {
          "type": "string"
        },
        "wp": {
          "type": "string"
        },
        "wc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wp": {
          "type": "string"
        },
        "wc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "required": [
        "baseBranch"
      ],
      "additionalProperties": false,
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "tagFormat": {
          "type": "string",
          "default": "v{version}"
        },
        "branchTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "install": {
          "type": "string"
        },
        "dev": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "e2e": {
          "type": "string"
        },
        "e2e-install": {
          "type": "string"
        },
        "e2e-start": {
          "type": "string"
        },
        "e2e-stop": {
          "type": "string"
        },
        "e2e-reset": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          ],
          "description": "zip glob, or edition -> glob"
        },
        "forbidden": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "edition -> paths that must not be in that edition's zip"
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "globs (relative to the zip's top folder) exempt from the dev-file warnings"
        }
      }
    },
    "versionFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "pattern"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        }
      }
    },
    "generatedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readme": {
          "type": "string",
          "default": "readme.txt"
        },
        "notesDir": {
          "type": "string",
          "default": "docs/releases"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wpPath": {
          "type": "string",
          "description": "WordPress root of the local dev site, absolute or relative to the repo"
        },
        "url": {
          "type": "string"
        },
        "debugLog": {
          "type": "string",
          "description": "Path to debug.log; default <wpPath>/wp-content/debug.log"
        }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "description": "Browser tests (reference/e2e.md). Written by /yay:e2e-setup.",
      "properties": {
        "dir": {
          "type": "string",
          "default": "tests/e2e",
          "description": "The e2e package folder, relative to the repo root"
        },
        "port": {
          "type": "integer",
          "description": "The main checkout's wp-env port. Default: 8900-9890 derived from plugin.slug. Worktrees always get their own"
        },
        "baseUrl": {
          "type": "string",
          "description": "Run specs against this external site instead of wp-env (per developer, .yay/local.json)"
        },
        "wpEnvArgs": {
          "type": "string",
          "description": "Extra wp-env arguments for yayh e2e cli, e.g. --config=.wp-env.single.json"
        }
      }
    }
  }
}
